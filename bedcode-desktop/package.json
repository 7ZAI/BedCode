{
  "name": "bedcode-desktop",
  "version": "1.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite optimize && vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "playwright install",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "target:size": "node scripts/check-target-size.js",
    "target:clean": "cd src-tauri && cargo clean",
    "prebuild": "node scripts/check-target-size.js",
    "plugins:build": "cd src/plugins/com.bedcode.ai-chatbox && npx vite build",
    "plugins:build:all": "npm run plugins:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "echarts": "^6.1.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "vue": "^3.4.21",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "happy-dom": "^13.6.0",
    "icon-gen": "^5.0.0",
    "png-to-icns": "^1.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6"
  }
}
