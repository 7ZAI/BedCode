{
  "name": "bedcode-desktop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "dev": "vite optimize && vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "../node_modules/.bin/eslint . --cache --fix",
    "format": "../node_modules/.bin/prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "wdio run wdio.conf.ts",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev-run.js",
    "tauri:build": "node scripts/tauri-build.js",
    "target:size": "node scripts/check-target-size.js",
    "target:clean": "cd src-tauri && cargo clean",
    "prebuild": "node scripts/check-target-size.js",
    "plugins:build": "node scripts/plugin-build.js --plugin com.bedcode.ai-chatbox && node scripts/plugin-build.js --plugin com.bedcode.auto-task && node scripts/plugin-build.js --plugin com.bedcode.file-transfer",
    "plugins:build:frontend": "pnpm -C plugins/ai-chatbox run build:frontend",
    "plugins:build:rust": "pnpm -C plugins/ai-chatbox run build:rust",
    "plugins:build:all": "pnpm run plugins:build",
    "plugins:dev": "node scripts/plugin-dev.js",
    "plugins:build:release": "node scripts/plugin-build.js"
  },
  "dependencies": {
    "@binblink/plugin-sdk-desktop": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "echarts": "^6.1.0",
    "loglevel": "^1.9.2",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "vue": "^3.4.21",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "@vue/test-utils": "^2.4.5",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.31.2",
    "autoprefixer": "^10.4.18",
    "happy-dom": "^13.6.0",
    "icon-gen": "^5.0.0",
    "png-to-icns": "^1.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "postcss-html": "^2.0.0",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.6",
    "webdriverio": "^9.31.7"
  }
}
