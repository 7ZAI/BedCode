{
  "i18n-ally.localesPaths": [
    "src/locales"
  ],
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // ==================== rust-analyzer 项目锁定（新增） ====================
  // linkedProjects 禁用递归发现，本文件夹只编译宿主工程 src-tauri/Cargo.toml
  // （+ path 依赖 plugin-sdk-desktop、packages/peer-net、packages/link-crypto）。
  // 若不锁定，RA 会递归发现本目录下 plugins/*/rust、packages/plugin-sdk-*、
  // packages/plugin-*-test 等约 14 个独立组件工程并在单实例内一起索引（内存爆炸）。
  // 插件/SDK/测试组件的工程各自独立，单独开发时直接打开对应目录。
  "rust-analyzer.linkedProjects": [
    "src-tauri/Cargo.toml"
  ],
  // ==================== rust-analyzer 内存优化 ====================
  // 与仓库根 .vscode/settings.json 同策略（详见 .vscode/README.md）：
  // 本机 12GB 内存，swap 已满，双 Tauri 项目同时索引曾触发 oomd 杀进程。
  "files.watcherExclude": {
    "**/target/**": true,
    "**/gen/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true
  },
  "rust-analyzer.files.exclude": [
    "target",
    "gen",
    "src-tauri/target",
    "src-tauri/gen",
    "node_modules"
  ],
  "rust-analyzer.cachePriming.enable": false,
  "rust-analyzer.lru.capacity": 64,
  "rust-analyzer.procMacro.processes": 1,
  "rust-analyzer.checkOnSave": false,
  "rust-analyzer.numThreads": 4,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.cargo.buildScripts.enable": true
}
