{
  "productName": "BedCode",
  "identifier": "com.bedcode.app",
  "version": "2.1.1",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BedCode",
        "width": 1300,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "backgroundColor": "#15130F"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' asset: http://asset.localhost",
        "font-src": "'self' asset: http://asset.localhost",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval' asset: http://asset.localhost"
      },
      "devCsp": {
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http: https:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/**/*", "$APPCONFIG/**/*", "$APPDATA/**/*"]
        }
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb"],
    "category": "Utility",
    "shortDescription": "局域网远程终端——移动端控制桌面端 Claude Code 会话",
    "resources": [
      "resources/config.properties",
      "resources/plugins/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.svg",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/icon-cache-refresh.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libdbus-1-3"
        ],
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "resources/deb/bedcode.desktop",
        "postInstallScript": "resources/deb/postinst"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/7ZAI/BedCode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MzBFQTkzQjg0MzYzREUKUldUZVkwTzRrK293dU1MVHllRVdrVElYRnNiUk4rV3oyTjhoZUpOYU5JbWpxK2ZjSlUwVmpMNXQK"
    }
  }
}
