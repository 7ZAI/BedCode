{
  "id": "com.bedcode.devices",
  "name": "Device Auth Center",
  "version": "0.1.0",
  "description": "认证中心（headless）：收敛远程终端配对 / 信任 / 同意决策语义为单一权威。骨架期：async 宿主加载/激活/可调用闭环 + manifest api/permissions 声明；pairing / trust / consent 模块随票 07-09 落地。",
  "author": "BedCode",
  "main": "",
  "sandbox": "inline",
  "pluginType": "rust",
  "rustLibrary": "bedcode_plugin_devices",
  "permissions": [
    "auth",
    "storage",
    "peer"
  ],
  "api": [
    "com.bedcode.devices.hello",
    "com.bedcode.devices.decide-consent",
    "com.bedcode.devices.list-trusted-devices",
    "com.bedcode.devices.pairing-code-generate",
    "com.bedcode.devices.pairing-code-status",
    "com.bedcode.devices.pairing-code-verify",
    "com.bedcode.devices.pairing-code-clear",
    "com.bedcode.devices.qr-code-generate",
    "com.bedcode.devices.qr-code-status",
    "com.bedcode.devices.qr-code-verify",
    "com.bedcode.devices.qr-code-clear"
  ],
  "contributes": {
    "commands": [
      {
        "id": "devices.status",
        "title": "Device Auth Center Status"
      }
    ],
    "views": [],
    "lifecycle": {
      "onStartup": false,
      "onShutdown": false
    },
    "provides": []
  }
}
