        "title": "Set Active Peer"
      },
      {
        "id": "file-transfer.list-remote",
        "title": "List Remote Files"
      },
      {
        "id": "file-transfer.enqueue",
        "title": "Enqueue Transfer"
      },
      {
        "id": "file-transfer.pause",
        "title": "Pause Transfer"
      },
      {
