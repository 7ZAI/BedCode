/// BedCode 插件 Component Model 契约
///
/// 对应 docs/knowledge/wasmtime-component-migration.md 阶段 B/C 的目标形态：
//! 将自研 ABI（`__bedcode_*` 导出 + `bedcode` 命名空间 host function）迁移为
//! WIT 接口 + wit-bindgen 绑定。本文件是单一事实来源，宿主侧
/// （`src-tauri/src/plugin/wasm_runtime/component.rs`）与插件侧（SDK，阶段 B）
/// 都基于它生成绑定，接口漂移在编译期即暴露。
///
/// 迁移约定（与阶段 B 第 4 点一致）：
/// - `serde_json` 载荷保留：结构化参数/结果一律用 `string` 承载 JSON
///   （WIT 的 `string` 到 wasm 侧是 UTF-8 字节，等价于现有 (ptr,len) 传递）
/// - 命令层（`CommandArgs` / `serde_json::Value`）不动，只有传输层换皮
/// - 错误一律 `result<T, string>`，错误内容为宿主侧可读的 UTF-8 消息
///
/// ## 命名空间约定
///
/// 宿主能力 import 接口前缀 `host-`，插件导出接口为普通名字：
/// - import：`host-storage` / `host-database` / ... （对应 host_functions/*）
/// - export：`command` / `lifecycle` / `events` / `terminal-hooks` /
///   `manifest` / `abi`
///
/// ## ABI 版本协商（阶段 A）
///
/// `abi` 接口承载原 `__bedcode_abi_version` 的职责，并新增 `form` 形态字段：
/// - `version()`：与 `abi::ABI_VERSION`（当前 v6）比对，语义不变
/// - `form()`：0 = core module（自研 ABI），1 = component。宿主据此区分产物形态，
///   不 bump ABI 大版本
package bedcode:plugin;

// ==================== 宿主能力 import（原 host_functions/* 13 组） ====================

/// 插件 KV 存储（原 storage.rs：storage_get/set/delete）
interface host-storage {
    get: func(key: string) -> result<option<string>, string>;
    set: func(key: string, value: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
}

/// 终端发送（原 terminal.rs：terminal_send）
interface host-terminal {
    send: func(session-id: string, data: string) -> result<_, string>;
}

/// 事件 / 广播 / 通知（原 events.rs：emit_event/broadcast_sync/notify）
interface host-events {
    emit: func(event-name: string, payload-json: string);
    broadcast-sync: func(event-json: string);
    notify: func(title: string, body: string) -> result<_, string>;
}

/// 消息总线（原 bus.rs：bus_publish/subscribe/unsubscribe）
interface host-bus {
    publish: func(topic: string, payload-json: string) -> result<_, string>;
    subscribe: func(topic: string) -> result<_, string>;
    unsubscribe: func(topic: string) -> result<_, string>;
}

/// 对等网络基础能力（issue 12 切换后：宿主只提供能力原语，
/// file-transfer 插件是首个上层消费者）
///
/// 发现/信任/拨号/收发/浏览的引擎全部在宿主 peer-net 层；本接口只是
/// 命令面的 WASM 投影。DTO 一律 JSON 字符串承载（camelCase，与 Tauri
/// 命令返回形状一致）。事件经消息总线 `peer:*` topic 推送（host-bus 订阅）：
/// - `peer:devices`    发现缓存全量列表变化
/// - `peer:connection` 节点连上/断开
/// - `peer:consent`    首次连接确认请求
/// - `peer:transfer`   发送任务列表变化（含进度与终态）
/// - `peer:receive`    接收侧变化（待应答批/进行中接收）
interface host-peer {
    /// 发现缓存全量列表 → DiscoveredPeerDto JSON 数组
    list-devices: func() -> result<string, string>;
    /// 拨号连接指定节点（等待对端确认）→ DialPeerResultDto JSON
    dial-peer: func(node-id: string) -> result<string, string>;
    /// 按 endpoint 拨号连接（ADR 0022 v2）：endpoint = `{ nodeId, addr, port }`
    /// （camelCase JSON，插件从自身设备缓存/mdns 事件解析后显式传入；宿主不再内藏
    /// node-id → 地址解析表）。握手期「证书指纹 ↔ nodeId 绑定 + 信任检查」语义不变。
    /// 成功返回 session 句柄（`sess-<uuid>`，后续按句柄寻址）；denied/unreachable
    /// 以错误上抛（携带状态字样）
    dial-peer-endpoint: func(endpoint-json: string) -> result<string, string>;
    /// 统一资源关闭（ADR 0022 v2）：session 句柄 = 断开连接；传输句柄 = 取消传输
    /// （先发送批取消、后接收批取消——pending 接收批被关闭即拒绝，闸门 fail-safe
    /// 的自然结果）。返回是否命中并关闭了任意资源
    close: func(handle: string) -> result<bool, string>;
    /// 断开与指定节点的会话（返回是否存在该会话）
    ///
    /// 旧式寻址入口（ADR 0022 v2 起由 `close` 取代）：并行保留至插件切换完成
    /// （Phase 4 退役）。
    disconnect-peer: func(node-id: string) -> result<bool, string>;
    /// 首次连接确认应答（返回是否命中了待确认项）
    respond-consent: func(request-id: string, accepted: bool) -> result<bool, string>;
    /// 可信对端列表 → TrustedPeerDto JSON 数组
    list-trusted: func() -> result<string, string>;
    /// 撤销对指定节点的信任（返回是否删除了条目）
    revoke-trusted: func(node-id: string) -> result<bool, string>;
    /// 向单个对端发送一批文件（目录递归展开、同名去重由宿主完成；
    /// 扇出 = 对多个对端各调一次，各批相互独立）→ PeerTransferDto JSON
    ///
    /// ADR 0022 过渡期双态寻址：首参可为 session 句柄（`sess-<uuid>`）或旧式
    /// node-id；返回 DTO 的 batchId 即传输句柄（可传给 close 取消）。Phase 4
    /// 收紧为仅句柄。
    send-files: func(node-id: string, paths-json: string) -> result<string, string>;
    /// 发送任务列表（含历史）→ PeerTransferDto JSON 数组
    list-transfers: func() -> result<string, string>;
    /// 取消发送批
    cancel-transfer: func(batch-id: string) -> result<bool, string>;
    /// 重试失败/被拒/取消的发送批（断点续传）→ PeerTransferDto JSON
    retry-transfer: func(batch-id: string) -> result<string, string>;
    /// 清空发送+接收历史（返回清除条数）
    clear-transfer-history: func() -> result<u32, string>;
    /// 待应答/进行中的接收任务 → PeerTransferDto JSON 数组
    list-receiving: func() -> result<string, string>;
    /// 接收批应答：accept=false 或超时视为拒绝
    respond-transfer: func(batch-id: string, accept: bool) -> result<_, string>;
    /// 取消进行中的接收批（pending 视为拒绝）
    cancel-receiving: func(batch-id: string) -> result<bool, string>;
    /// 清空接收终态记录（返回清除条数）
    clear-receiving-history: func() -> result<u32, string>;
    /// 接收设置 → { policyMode, timeoutSecs, downloadDir } JSON
    get-receive-settings: func() -> result<string, string>;
    /// 设置接收策略：mode = "ask" | "always_accept" | "always_deny"
    set-receive-policy: func(mode: string, timeout-secs: u64) -> result<_, string>;
    /// 本机暴露的共享目录 → SharedDirDto JSON 数组
    list-shared-directories: func() -> result<string, string>;
    /// 移除共享目录条目
    remove-shared-directory: func(id: string) -> result<bool, string>;
    /// 新增共享目录：request = { name?: string, path?: string }
    /// （桌面端用 path；移动端忽略 path 弹 SAF 目录树选择器）→ SharedDirDto JSON
    ///
    /// 旧式单条 CRUD（ADR 0022 v2 起由 `set-shared-roots` 取代）：并行保留至
    /// 插件切换完成（Phase 4 退役）。
    add-shared-directory: func(request-json: string) -> result<string, string>;
    /// 全量幂等替换引擎广播源（ADR 0022 v2）：条目 `[{ id, name, path }]`
    /// （camelCase JSON；移动端 SAF 树以 `safTreeUri` 字段替代 `path`）。
    /// 注册表 CRUD 真源在插件侧，本函数只同步暴露面镜像；任一条目非法整批拒绝
    set-shared-roots: func(dirs-json: string) -> result<_, string>;
    /// 浏览对端共享根清单 → PeerSharedRootDto JSON 数组
    ///
    /// ADR 0022 过渡期双态寻址：首参可为 session 句柄或旧式 node-id（下同：
    /// browse-directory / pull-files），Phase 4 收紧为仅句柄。
    list-shared-roots: func(node-id: string) -> result<string, string>;
    /// 目录下钻 → RemoteBrowseDto JSON
    browse-directory: func(node-id: string, dir-id: string, rel-path: string) -> result<string, string>;
    /// 拉取对端文件（files = RemotePullFileDto JSON 数组）→ 入队文件数
    pull-files: func(node-id: string, dir-id: string, files-json: string) -> result<u32, string>;
    /// 系统多文件选择器 → string[] JSON（用户取消为空数组）
    ///
    /// 旧归属（ADR 0022 v2 起移入 host-platform）：并行保留至 Phase 4 退役。
    pick-files: func() -> result<string, string>;
    /// 系统文件夹选择器（共享目录源）→ 绝对路径；用户取消返回空串
    ///
    /// 旧归属（ADR 0022 v2 起移入 host-platform）：并行保留至 Phase 4 退役。
    pick-folder: func() -> result<string, string>;
    /// 设置接收落点目录（空串 = 恢复默认 Downloads\BedCode\）
    set-download-dir: func(path: string) -> result<_, string>;
    /// 设置发送加密开关（应用层 AES-256-GCM；接收端经 Offer 头自动解密）
    set-transfer-encryption: func(enabled: bool) -> result<_, string>;
}

/// mDNS 浏览纯能力（ADR 0022 v2）：browse-only，发现/离开事件原样透传
///
/// 发现/离开经消息总线 `mdns:found` / `mdns:lost` 推送（host-bus 订阅），
/// payload 原样透传：`{ instanceName, addresses: string[], port, txtRecords:
/// Record<string,string> }`，宿主不做任何加工。设备列表（去重/TTL 过期/展示名
/// 解读）是发现事件的派生视图，由消费插件自建缓存。
///
/// 自我广播（register/advertise）不进本接口：「本机是谁」与宿主 TLS 监听器
/// 同生共死，留在 peer-net 启动流程自动完成；无插件激活时主机照样可被发现。
interface host-mdns {
    /// 浏览某服务类型，返回 browser 句柄；重复浏览同一类型允许（各自独立生命周期）
    browse: func(service-type: string) -> result<string, string>;
    /// 停止浏览并回收句柄（返回是否存在该句柄）；插件停用时宿主自动回收其全部句柄
    stop-browse: func(browser-id: string) -> result<bool, string>;
}

/// 通用平台能力域（ADR 0022 v2）：系统对话框/授权等与领域无关的平台交互
interface host-platform {
    /// 系统多文件选择器 → string[] JSON（用户取消为空数组）；
    /// 选择即用户授权动作，不叠加权限门
    pick-files: func() -> result<string, string>;
    /// 系统文件夹选择器 → 绝对路径；用户取消返回空串
    /// （移动端为 SAF 目录树选择器，返回树 URI）
    pick-folder: func() -> result<string, string>;
}

/// 插件互调（ADR-0017）：发布 JSON-RPC 请求 + 同步等待回复
interface host-api-call {
    /// 发布请求到 request-topic（宿主按 `bedcode.api.*` 门禁校验目标 api
    /// 已被某激活插件声明，未声明拒绝），并按调用方插件 ID + 请求载荷中的
    /// 字符串 `id` 构造响应 topic（`bedcode.api.reply.<caller-id>.<request-id>`），
    /// 宿主侧注册静态回复订阅 + 阻塞等待（调用方 wasm 实例阻塞期间无法接收
    /// on_message，回复必须宿主侧消费，见 SDK api_call 模块注释）。
    /// 返回回复 JSON 字符串（result | error 对象）；超时/门禁拒绝返回错误。
    call: func(request-topic: string, payload-json: string, timeout-ms: u64) -> result<string, string>;
}

/// HTTP 代理（原 http.rs：http_fetch）
interface host-http {
    fetch: func(request-json: string) -> result<option<string>, string>;
}

/// 宿主周期定时器（原 timer.rs：timer_register，ABI v6）
interface host-timer {
    register: func(interval-secs: u64, command: string) -> result<_, string>;
}

/// 进程执行（v8：host-process）——调度框架等插件需要执行外部命令/脚本
///
/// 异步执行：`run` 立即返回 run-id，进程结束后宿主经 `events.on-process-done`
/// 回调插件（携带 exit_code / 超时标记）；`kill` 用于超时/取消。
interface host-process {
    run: func(request-json: string) -> result<string, string>;
    kill: func(run-id: string) -> result<_, string>;
}

/// 插件随包 CLI 生命周期（v8：host-app）——安装/卸载到用户 bin 目录并注册 PATH
///
/// WASM 插件无注册表/文件系统写权限的直接通道，PATH 操作由宿主侧实现：
/// 插件在 activate 时安装自身随包的 cli/ 产物（如 bedtask），停用时卸载。
/// 幂等：重复安装不产生重复条目，升级覆盖；卸载仅移除本插件条目。
interface host-app {
    /// 安装 CLI（幂等）：源 = 插件包目录 `cli/<file-name>`（Windows 自动补 .exe），
    /// 复制到用户 bin 目录并注册 PATH；`bin-dir` 为空用平台默认
    /// （Windows `%LOCALAPPDATA%/com.bedcode.app/bin`；unix `~/.bedcode/bin`）。
    /// 返回安装后的 bin 目录绝对路径。
    install-cli: func(payload-json: string) -> result<string, string>;
    /// 卸载 CLI（幂等）：删除文件 + 移除仅本插件添加的 PATH 条目
    /// （保留用户原有项）；应用关闭流程中调用时自动跳过（CLI 随下次激活重建）
    uninstall-cli: func(payload-json: string) -> result<_, string>;
}

/// 文件系统访问（原 fs.rs：fs_read/write/copy/delete/exists）
interface host-fs {
    read: func(path: string) -> result<option<string>, string>;
    write: func(path: string, data: string) -> result<_, string>;
    copy: func(src: string, dst: string) -> result<_, string>;
    delete: func(path: string) -> result<_, string>;
    exists: func(path: string) -> result<bool, string>;
    /// 批量请求目录授权：未授权路径合并为一次用户弹窗，阻塞等待答复
    /// （paths-json 为 JSON 字符串数组；返回是否全部同意）
    request-auth: func(paths-json: string) -> result<bool, string>;
}

/// 宿主日志与插件状态上报（原 log.rs + status.rs）
interface host-log {
    info: func(message: string);
    debug: func(message: string);
    warn: func(message: string);
    error: func(message: string);
    mark-plugin-error: func(error: string);
}

/// 宿主配置读取（原 config.rs：config_get，key 为 ConfigKey::as_str 的字符串）
interface host-config {
    get: func(key: string) -> result<option<string>, string>;
}

/// 会话能力（原 session.rs：session_list/get/config_list/create + lifecycle.rs 注册）
///
/// 注：WIT 中 `list` 是类型关键字，列表函数命名为 `list-sessions`
interface host-session {
    list-sessions: func() -> result<option<string>, string>;
    get: func(session-id: string) -> result<option<string>, string>;
    config-list: func() -> result<option<string>, string>;
    lifecycle-register: func() -> result<_, string>;
    input-register: func() -> result<_, string>;
    create: func(config-id: string) -> result<string, string>;
    /// 关闭（终止）会话（v7）：停止 PTY 并置 Stopped，会话记录保留
    /// （与用户手动关闭一致）；宿主分发 Stopping/Stopped 生命周期事件。
    /// 供插件在定时自动任务执行完后清理自己创建的会话。
    close: func(session-id: string) -> result<_, string>;
}

/// 主数据库（原 database.rs：db_execute/query/execute_params/query_params）
interface host-database {
    execute: func(sql: string) -> result<u32, string>;
    query: func(sql: string) -> result<option<string>, string>;
    execute-params: func(sql: string, params-json: string) -> result<u32, string>;
    query-params: func(sql: string, params-json: string) -> result<option<string>, string>;
}

/// 插件独立数据库（原 database.rs：plugin_db_*）
interface host-plugin-database {
    execute: func(sql: string) -> result<u32, string>;
    query: func(sql: string) -> result<option<string>, string>;
    execute-params: func(sql: string, params-json: string) -> result<u32, string>;
    query-params: func(sql: string, params-json: string) -> result<option<string>, string>;
}

// ==================== 插件导出（原 __bedcode_* 导出函数） ====================

/// 命令入口（原 invoke_command，JSON 载荷保留）
interface command {
    invoke: func(name: string, args-json: string) -> string;
}

/// 生命周期（原 activate/deactivate/on_startup/on_shutdown）
///
/// 四个导出均携带结果（v8）：启动初始化/清理的成败由导出返回值如实上抛，
/// 宿主据此区分 Activated / Degraded，不再依赖「调用没抛错」推断成功
interface lifecycle {
    activate: func() -> result<_, string>;
    deactivate: func() -> result<_, string>;
    on-startup: func() -> result<_, string>;
    on-shutdown: func() -> result<_, string>;
}

/// 事件回调（原 on_message/on_session_lifecycle/on_input_submitted）
interface events {
    on-message: func(topic: string, sender: string, payload-json: string) -> result<_, string>;
    on-session-lifecycle: func(payload-json: string) -> result<_, string>;
    on-input-submitted: func(payload-json: string) -> result<_, string>;
    /// 进程执行完成回调（v8）：host-process run 的进程结束时触发
    /// （正常退出 / 非零退出 / 超时 kill），payload-json 为
    /// `{ run_id, exit_code, timed_out }`
    on-process-done: func(payload-json: string) -> result<_, string>;
}

/// 终端输入/输出钩子（原 on_terminal_input/on_terminal_output）
interface terminal-hooks {
    on-terminal-input: func(session-id: string, text: string) -> option<string>;
    on-terminal-output: func(session-id: string, data: string) -> option<string>;
}

/// 插件 manifest（原 __bedcode_manifest，JSON 字符串）
interface manifest {
    get: func() -> string;
}

/// ABI 版本协商（原 __bedcode_abi_version + 阶段 A 新增 form 形态字段）
interface abi {
    version: func() -> u32;
    form: func() -> u32;
}

// ==================== World ====================

/// 插件世界：宿主能力全部为 import，插件行为全部为 export
///
/// 阶段 A 收尾后宿主已全部接线（13 组 import），完整 world 可直接实例化；
/// 阶段 B SDK 构建脚本以本 world 生成 guest 绑定。
world plugin {
    import host-storage;
    import host-database;
    import host-plugin-database;
    import host-terminal;
    import host-session;
    import host-events;
    import host-http;
    import host-fs;
    import host-config;
    import host-log;
    import host-bus;
    import host-api-call;
    import host-peer;
    import host-mdns;
    import host-platform;
    import host-timer;
    import host-process;
    import host-app;

    export command;
    export lifecycle;
    export events;
    export terminal-hooks;
    export manifest;
    export abi;
}
