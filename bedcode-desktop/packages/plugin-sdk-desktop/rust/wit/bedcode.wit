/// BedCode 插件 Component Model 契约
///
/// 对应 docs/knowledge/wasmtime-component-migration.md 阶段 B/C 的目标形态：
//! 将自研 ABI（`__bedcode_*` 导出 + `bedcode` 命名空间 host function）迁移为
//! WIT 接口 + wit-bindgen 绑定。本文件是单一事实来源，宿主侧
/// （`src-tauri/src/plugin/wasm_runtime/component.rs`）与插件侧（SDK，阶段 B）
/// 都基于它生成绑定，接口漂移在编译期即暴露。
///
/// 迁移约定（与阶段 B 第 4 点一致）：
/// - `serde_json` 载荷保留：结构化参数/结果一律用 `string` 承载 JSON
///   （WIT 的 `string` 到 wasm 侧是 UTF-8 字节，等价于现有 (ptr,len) 传递）
/// - 命令层（`CommandArgs` / `serde_json::Value`）不动，只有传输层换皮
/// - 错误一律 `result<T, string>`，错误内容为宿主侧可读的 UTF-8 消息
///
/// ## 命名空间约定
///
/// 宿主能力 import 接口前缀 `host-`，插件导出接口为普通名字：
/// - import：`host-storage` / `host-database` / ... （对应 host_functions/*）
/// - export：`command` / `lifecycle` / `events` / `terminal-hooks` /
///   `manifest` / `abi`
///
/// ## ABI 版本协商（阶段 A）
///
/// `abi` 接口承载原 `__bedcode_abi_version` 的职责，并新增 `form` 形态字段：
/// - `version()`：与 `abi::ABI_VERSION`（当前 v6）比对，语义不变
/// - `form()`：0 = core module（自研 ABI），1 = component。宿主据此区分产物形态，
///   不 bump ABI 大版本
package bedcode:plugin;

// ==================== 宿主能力 import（原 host_functions/* 13 组） ====================

/// 插件 KV 存储（原 storage.rs：storage_get/set/delete）
interface host-storage {
    get: func(key: string) -> result<option<string>, string>;
    set: func(key: string, value: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
}

/// 终端发送（原 terminal.rs：terminal_send）
interface host-terminal {
    send: func(session-id: string, data: string) -> result<_, string>;
}

/// 事件 / 广播 / 通知（原 events.rs：emit_event/broadcast_sync/notify）
interface host-events {
    emit: func(event-name: string, payload-json: string);
    broadcast-sync: func(event-json: string);
    notify: func(title: string, body: string) -> result<_, string>;
}

/// 消息总线（原 bus.rs：bus_publish/subscribe/unsubscribe）
///
/// 载荷格式（v11）：
/// - `publish`（JSON 文本，v1 起）：结构化载荷，现有订阅方零回归；
/// - `publish-binary`（字节列，v11 起）：零 JSON 编解码，可传非 UTF-8
///   与大载荷（MB 级）。订阅方以 `subscribe-binary` 声明二进制格式偏好，
///   格式不匹配的投递被宿主拒绝（不进入订阅者队列）并告警
interface host-bus {
    publish: func(topic: string, payload-json: string) -> result<_, string>;
    /// v11：二进制载荷发布（字节列原样透传）
    publish-binary: func(topic: string, payload: list<u8>) -> result<_, string>;
    subscribe: func(topic: string) -> result<_, string>;
    /// v11：以二进制格式偏好订阅——只接收 publish-binary 投递，
    /// JSON 消息对其按格式不匹配拒绝
    subscribe-binary: func(topic: string) -> result<_, string>;
    unsubscribe: func(topic: string) -> result<_, string>;
}

/// 对等网络基础能力（issue 12 切换后：宿主只提供能力原语，
/// file-transfer 插件是首个上层消费者）
///
/// 发现/信任/拨号/收发/浏览的引擎全部在宿主 peer-net 层；本接口只是
/// 命令面的 WASM 投影。DTO 一律 JSON 字符串承载（camelCase，与 Tauri
/// 命令返回形状一致）。事件经消息总线 `peer:*` topic 推送（host-bus 订阅）：
/// - `peer:devices`    发现缓存全量列表变化
/// - `peer:connection` 节点连上/断开
/// - `peer:consent`    首次连接确认请求
/// - `peer:transfer`   发送任务列表变化（含进度与终态）
/// - `peer:receive`    接收侧变化（待应答批/进行中接收）
interface host-peer {
    /// 按 endpoint 拨号连接（ADR 0022 v2 终态，原 dial-peer-endpoint 转正）：
    /// endpoint = `{ nodeId, addr, port }`（camelCase JSON，插件从自身设备缓存/
    /// mdns 事件解析后显式传入；宿主不内藏 node-id → 地址解析表）。握手期
    /// 「证书指纹 ↔ nodeId 绑定 + 信任检查」语义不变。成功返回 session 句柄
    /// （`sess-<uuid>`，后续按句柄寻址）；denied/unreachable 以错误上抛
    dial-peer: func(endpoint-json: string) -> result<string, string>;
    /// 统一资源关闭（ADR 0022 v2）：session 句柄 = 断开连接；传输句柄 = 取消传输
    /// （先发送批取消、后接收批取消——pending 接收批被关闭即拒绝，闸门 fail-safe
    /// 的自然结果）。返回是否命中并关闭了任意资源
    close: func(handle: string) -> result<bool, string>;
    /// 首次连接确认应答（返回是否命中了待确认项）
    respond-consent: func(request-id: string, accepted: bool) -> result<bool, string>;
    /// 可信对端列表 → TrustedPeerDto JSON 数组
    list-trusted: func() -> result<string, string>;
    /// 撤销对指定节点的信任（返回是否删除了条目）
    revoke-trusted: func(node-id: string) -> result<bool, string>;
    /// 向单个对端发送一批文件（目录递归展开、同名去重由宿主完成；
    /// 扇出 = 对多个对端各调一次，各批相互独立）→ 传输句柄（batch-id 字符串）
    ///
    /// 仅接受 session 句柄寻址；paths 元素双形态：纯 string 或 `{ path, encrypt? }`
    /// 对象（任一元素 encrypt=true → 本批强制加密）。连接已断时以句柄记忆的
    /// endpoint 自动重拨（信任检查照走引擎握手）
    send-files: func(session-handle: string, paths-json: string) -> result<string, string>;
    /// 接收批应答：accept=false 或超时视为拒绝
    respond-transfer: func(batch-id: string, accept: bool) -> result<_, string>;
    /// 设置接收策略（引擎安全闸门配置原语，ADR 0022 v3）：mode = "ask" |
    /// "always_accept" | "always_deny"；产品真源在插件侧，经本原语推送宿主闸门
    set-receive-policy: func(mode: string, timeout-secs: u64) -> result<_, string>;
    /// 显式暂停进行中的发送批（batch-id 寻址）：中断会话连接，任务保留
    /// （含已传字节）不落历史，接收端按已写偏移保留待续传；仅本端发起的
    /// running 批可暂停，暂停释放一个并发槽位。无命中返回错误
    pause-transfer: func(batch-id: string) -> result<_, string>;
    /// 恢复暂停的发送批：入队并经并发闸门启动，接收端按已写偏移续传
    /// （断点真源在落盘侧）；无命中返回错误
    resume-transfer: func(batch-id: string) -> result<_, string>;
    /// 恢复全部暂停的发送批，返回入队数（0 = 无暂停批）
    resume-all-transfers: func() -> result<u32, string>;
    /// 全量幂等替换引擎广播源（ADR 0022 v2）：条目 `[{ id, name, path }]`
    /// （camelCase JSON；移动端 SAF 树以 `safTreeUri` 字段替代 `path`）。
    /// 注册表 CRUD 真源在插件侧，本函数只同步暴露面镜像；任一条目非法整批拒绝
    set-shared-roots: func(dirs-json: string) -> result<_, string>;
    /// 浏览对端共享根清单 → PeerSharedRootDto JSON 数组（仅 session 句柄寻址；
    /// 连接已断时以句柄记忆的 endpoint 自动重拨）
    list-shared-roots: func(session-handle: string) -> result<string, string>;
    /// 目录下钻 → RemoteBrowseDto JSON（仅 session 句柄寻址；重拨语义同上）
    browse-directory: func(session-handle: string, dir-id: string, rel-path: string) -> result<string, string>;
    /// 拉取对端文件（files = RemotePullFileDto JSON 数组）→ 入队文件数
    /// （仅 session 句柄寻址；重拨语义同上）
    pull-files: func(session-handle: string, dir-id: string, files-json: string) -> result<u32, string>;
    /// 设置接收落点目录（空串 = 恢复默认 Downloads\BedCode\；引擎落盘配置原语，
    /// ADR 0022 v3）
    set-download-dir: func(path: string) -> result<_, string>;
}

/// mDNS 浏览纯能力（ADR 0022 v2）：browse-only，发现/离开事件原样透传
///
/// 发现/离开经消息总线 `mdns:found` / `mdns:lost` 推送（host-bus 订阅），
/// payload 原样透传：`{ instanceName, addresses: string[], port, txtRecords:
/// Record<string,string> }`，宿主不做任何加工。设备列表（去重/TTL 过期/展示名
/// 解读）是发现事件的派生视图，由消费插件自建缓存。
///
/// 自我广播（register/advertise）不进本接口：「本机是谁」与宿主 TLS 监听器
/// 同生共死，留在 peer-net 启动流程自动完成；无插件激活时主机照样可被发现。
interface host-mdns {
    /// 浏览某服务类型，返回 browser 句柄；重复浏览同一类型允许（各自独立生命周期）。
    /// 事件定向投递到 `mdns:found.<plugin-id>` / `mdns:lost.<plugin-id>`（宿主实现）
    browse: func(service-type: string) -> result<string, string>;
    /// 停止浏览并回收句柄（返回是否存在该句柄）；仅属主可停（跨插件拒绝）；
    /// 插件停用时宿主自动回收其全部句柄
    stop-browse: func(browser-id: string) -> result<bool, string>;

    /// 广播某服务类型（v2 新增）：返回 advertise 句柄。
    /// config-json 为纯引擎参数（服务类型 / 实例名 / 端口 / TXT 键值），
    /// 宿主零业务拼装；实例名省略时宿主按 `{plugin}-{短指纹}` 默认。
    advertise: func(config-json: string) -> result<string, string>;
    /// 停止广播并回收句柄（返回是否存在该句柄）；仅属主可停；
    /// 插件停用时宿主自动回收其全部广播句柄。
    stop-advertise: func(advertise-id: string) -> result<bool, string>;
    /// 查询广播状态（返回是否存在该句柄）；仅属主可查。
    is-advertising: func(advertise-id: string) -> result<bool, string>;
}

/// 通用平台能力域（ADR 0022 v2）：系统对话框/授权等与领域无关的平台交互
interface host-platform {
    /// 系统多文件选择器 → string[] JSON（用户取消为空数组）；
    /// 选择即用户授权动作，不叠加权限门
    pick-files: func() -> result<string, string>;
    /// 系统文件夹选择器 → 绝对路径；用户取消返回空串
    /// （移动端为 SAF 目录树选择器，返回树 URI）
    pick-folder: func() -> result<string, string>;
    /// 系统多目录选择器 → string[] JSON（用户取消为空数组）
    pick-folders: func() -> result<string, string>;
}

/// 插件互调（ADR-0017）：发布 JSON-RPC 请求 + 同步等待回复
interface host-api-call {
    /// 发布请求到 request-topic（宿主按 `bedcode.api.*` 门禁校验目标 api
    /// 已被某激活插件声明，未声明拒绝），并按调用方插件 ID + 请求载荷中的
    /// 字符串 `id` 构造响应 topic（`bedcode.api.reply.<caller-id>.<request-id>`），
    /// 宿主侧注册静态回复订阅 + 阻塞等待（调用方 wasm 实例阻塞期间无法接收
    /// on_message，回复必须宿主侧消费，见 SDK api_call 模块注释）。
    /// 返回回复 JSON 字符串（result | error 对象）；超时/门禁拒绝返回错误。
    call: func(request-topic: string, payload-json: string, timeout-ms: u64) -> result<string, string>;
}

/// HTTP 代理（原 http.rs：http_fetch）
interface host-http {
    fetch: func(request-json: string) -> result<option<string>, string>;
}

/// 宿主周期定时器（原 timer.rs：timer_register，ABI v6）
interface host-timer {
    register: func(interval-secs: u64, command: string) -> result<_, string>;
}

/// 进程执行（v8：host-process）——调度框架等插件需要执行外部命令/脚本
///
/// 异步执行：`run` 立即返回 run-id，进程结束后宿主经 `events.on-process-done`
/// 回调插件（携带 exit_code / 超时标记）；`kill` 用于超时/取消。
interface host-process {
    run: func(request-json: string) -> result<string, string>;
    kill: func(run-id: string) -> result<_, string>;
}

/// 插件随包 CLI 生命周期（v8：host-app）——安装/卸载到用户 bin 目录并注册 PATH
///
/// WASM 插件无注册表/文件系统写权限的直接通道，PATH 操作由宿主侧实现：
/// 插件在 activate 时安装自身随包的 cli/ 产物（如 bedtask），停用时卸载。
/// 幂等：重复安装不产生重复条目，升级覆盖；卸载仅移除本插件条目。
interface host-app {
    /// 安装 CLI（幂等）：源 = 插件包目录 `cli/<file-name>`（Windows 自动补 .exe），
    /// 复制到用户 bin 目录并注册 PATH；`bin-dir` 为空用平台默认
    /// （Windows `%LOCALAPPDATA%/com.bedcode.app/bin`；unix `~/.bedcode/bin`）。
    /// 返回安装后的 bin 目录绝对路径。
    install-cli: func(payload-json: string) -> result<string, string>;
    /// 卸载 CLI（幂等）：删除文件 + 移除仅本插件添加的 PATH 条目
    /// （保留用户原有项）；应用关闭流程中调用时自动跳过（CLI 随下次激活重建）
    uninstall-cli: func(payload-json: string) -> result<_, string>;
}

/// WebSocket 基础能力服务（ADR 0022）：宿主 WS 传输原语，插件零业务语义。
///
/// 客户端域（出站）：连接外部 WS 服务器，连接句柄寻址。
/// 服务端域（入站）：在宿主 WS 服务器挂载插件端点；挂载路径由宿主按调用方
/// 插件注入命名空间段 —— `/ws/plugin/<plugin-id>/<path>`（D5）。
///
/// 属主隔离（spec §2.3 / D6）：**全部函数仅属主可调**（他人句柄/端点 → Err，
/// `not owner of ws handle`）；插件停用时宿主自动回收其全部句柄与端点。
/// 权限：客户端域需 `ws:client`，服务端域需 `ws:server`。
///
/// 事件投递（D2/D3）：状态事件经 host-bus 订阅，topic **内嵌 owner**
/// （非属主物理上订阅不到），标识在 payload：
///   客户端域  `ws:open.<owner>` / `ws:error.<owner>` / `ws:close.<owner>`
///   服务端域  `ws:client-connect.<owner>` / `ws:client-disconnect.<owner>`
/// 插件**须在 activate 期（或首次 connect/register-endpoint 之前）完成订阅**：
/// 宿主不缓冲、不重放，晚订阅期间的事件永久丢失；丢失自愈靠
/// `is-connected` / `list-clients` / `list-endpoints` 查询原语。
/// 消息帧（text + binary）经可选导出 `events-ws` 回调投递。
interface host-websocket {
    // ==================== 客户端域（出站连接） ====================
    /// 建立出站 WS 连接：**同步阻塞至握手完成**（上限 connect-timeout-secs，
    /// 与 host-http 非流式模式同款 block_on 语义，D4）。
    /// config-json（camelCase）纯引擎参数：
    /// `{ url, headers?, protocols?, connect-timeout-secs?, max-message-bytes? }`
    /// url **仅接受 `ws://`**（`wss://` 本期不支持，返回明确错误，D7）。
    /// 成功 → 返回连接句柄 `wsc-<uuid>` 并发布 `ws:open.<owner>`；
    /// 失败 → 错误上抛且**不发布任何事件**（无句柄可寻址）。
    connect: func(config-json: string) -> result<string, string>;
    /// 发送文本帧（UTF-8）；连接不存在/已关闭/发送队列满 → 错误（D10）
    send-text: func(handle: string, text: string) -> result<_, string>;
    /// 发送二进制帧；错误语义同 send-text
    send-binary: func(handle: string, payload: list<u8>) -> result<_, string>;
    /// 主动关闭连接（close-json：`{ code?, reason? }`，缺省 1000）；返回是否命中。
    /// 该连接的 `ws:close.<owner>` 随即上报（wasClean=true 当且仅当 code ∈ {1000,1001}）
    close: func(handle: string, close-json: string) -> result<bool, string>;
    /// 查询连接是否处于 open 态（握手完成且未关闭）；仅属主可查。
    /// 供插件在丢失状态事件后自愈（D3）
    is-connected: func(handle: string) -> result<bool, string>;

    // ==================== 服务端域（入站端点） ====================
    /// 在宿主 WS 服务器挂载插件端点（实际路径 `/ws/plugin/<plugin-id>/<path>`，
    /// 命名空间段由宿主注入，插件只提供后缀，D5）。
    /// config-json（camelCase）纯引擎参数：
    /// `{ path, auth?, max-message-bytes?, max-clients? }`
    /// auth = "none"（默认：跳过首消息认证状态机，插件自管认证）
    ///      | "jwt"（宿主校验首消息 `{"type":"auth","token":"<jwt>"}`，D8）。
    /// path 非法（空、含 `/`、含 `.`、超长）或与本插件已注册端点冲突 → 错误
    /// （跨插件不冲突：路径含 plugin-id 段）。返回端点句柄 `wse-<uuid>`。
    /// 端点存在期间的每一帧都经宿主流过滤器链（D9）
    register-endpoint: func(config-json: string) -> result<string, string>;
    /// 向端点的指定客户端发文本帧；客户端不存在/队列满 → 错误（D10）
    send-text-to-client: func(endpoint-id: string, client-id: string, text: string) -> result<_, string>;
    /// 向端点的指定客户端发二进制帧
    send-binary-to-client: func(endpoint-id: string, client-id: string, payload: list<u8>) -> result<_, string>;
    /// 向端点全部客户端广播文本帧 → 成功入队客户端数（部分失败不回滚，D10）
    broadcast-text: func(endpoint-id: string, text: string) -> result<u32, string>;
    /// 向端点全部客户端广播二进制帧 → 成功入队客户端数
    broadcast-binary: func(endpoint-id: string, payload: list<u8>) -> result<u32, string>;
    /// 主动踢出端点的单个客户端（close-json：`{ code?, reason? }`，缺省 4004）；
    /// 返回是否命中；随后该客户端经 `ws:client-disconnect.<owner>` 上报
    close-client: func(endpoint-id: string, client-id: string, close-json: string) -> result<bool, string>;
    /// 关闭端点并回收句柄（含下线全部客户端，close code 4005）；返回是否存在该端点
    unregister-endpoint: func(endpoint-id: string) -> result<bool, string>;
    /// 端点在线的客户端清单 → JSON 数组
    /// `[{ clientId, addr, authenticated, connectedAt }]`（camelCase）；
    /// 供插件在丢失 client-connect 事件后自愈（D3）；仅属主可查
    list-clients: func(endpoint-id: string) -> result<string, string>;
    /// 本插件已注册端点清单 → JSON 数组 `[{ endpointId, path, clientCount }]`；
    /// 仅属主可查
    list-endpoints: func() -> result<string, string>;
}

/// 文件系统访问（原 fs.rs：fs_read/write/copy/delete/exists）
interface host-fs {
    read: func(path: string) -> result<option<string>, string>;
    write: func(path: string, data: string) -> result<_, string>;
    copy: func(src: string, dst: string) -> result<_, string>;
    delete: func(path: string) -> result<_, string>;
    exists: func(path: string) -> result<bool, string>;
    /// 批量请求目录授权：未授权路径合并为一次用户弹窗，阻塞等待答复
    /// （paths-json 为 JSON 字符串数组；返回是否全部同意）
    request-auth: func(paths-json: string) -> result<bool, string>;
}

/// 宿主日志与插件状态上报（原 log.rs + status.rs）
interface host-log {
    info: func(message: string);
    debug: func(message: string);
    warn: func(message: string);
    error: func(message: string);
    mark-plugin-error: func(error: string);
}

/// 宿主配置读取（原 config.rs：config_get，key 为 ConfigKey::as_str 的字符串）
interface host-config {
    get: func(key: string) -> result<option<string>, string>;
}

/// 会话能力（原 session.rs：session_list/get/config_list/create + lifecycle.rs 注册）
///
/// 注：WIT 中 `list` 是类型关键字，列表函数命名为 `list-sessions`
interface host-session {
    list-sessions: func() -> result<option<string>, string>;
    get: func(session-id: string) -> result<option<string>, string>;
    config-list: func() -> result<option<string>, string>;
    lifecycle-register: func() -> result<_, string>;
    input-register: func() -> result<_, string>;
    create: func(config-id: string) -> result<string, string>;
    /// 关闭（终止）会话（v7）：停止 PTY 并置 Stopped，会话记录保留
    /// （与用户手动关闭一致）；宿主分发 Stopping/Stopped 生命周期事件。
    /// 供插件在定时自动任务执行完后清理自己创建的会话。
    close: func(session-id: string) -> result<_, string>;
}

/// 主数据库（原 database.rs：db_execute/query/execute_params/query_params）
///
/// v14 内纯增量追加 `execute-batch`（ABI 版本惯例：函数级追加不 bump，旧插件不受影响）：
/// 单次调用内宿主持有连接锁、事务内顺序执行多语句，任一句失败整体回滚。
/// 禁止跨调用裸 BEGIN/COMMIT（宿主对 execute/execute-params 做事务控制语句白名单检测）。
interface host-database {
    execute: func(sql: string) -> result<u32, string>;
    query: func(sql: string) -> result<option<string>, string>;
    execute-params: func(sql: string, params-json: string) -> result<u32, string>;
    query-params: func(sql: string, params-json: string) -> result<option<string>, string>;
    /// 事务内顺序执行多语句（sqls-json 为 SQL 字符串数组），返回受影响行数合计
    execute-batch: func(sqls-json: string) -> result<u32, string>;
}

/// 插件独立数据库（原 database.rs：plugin_db_*）
interface host-plugin-database {
    execute: func(sql: string) -> result<u32, string>;
    query: func(sql: string) -> result<option<string>, string>;
    execute-params: func(sql: string, params-json: string) -> result<u32, string>;
    query-params: func(sql: string, params-json: string) -> result<option<string>, string>;
    /// 事务内顺序执行多语句（sqls-json 为 SQL 字符串数组），返回受影响行数合计
    execute-batch: func(sqls-json: string) -> result<u32, string>;
}

// ==================== 插件导出（原 __bedcode_* 导出函数） ====================

/// 命令入口（原 invoke_command，JSON 载荷保留）
interface command {
    invoke: func(name: string, args-json: string) -> string;
}

/// 生命周期（原 activate/deactivate/on_startup/on_shutdown）
///
/// 四个导出均携带结果（v8）：启动初始化/清理的成败由导出返回值如实上抛，
/// 宿主据此区分 Activated / Degraded，不再依赖「调用没抛错」推断成功
interface lifecycle {
    activate: func() -> result<_, string>;
    deactivate: func() -> result<_, string>;
    on-startup: func() -> result<_, string>;
    on-shutdown: func() -> result<_, string>;
}

/// 事件回调（原 on_message/on_session_lifecycle/on_input_submitted）
interface events {
    on-message: func(topic: string, sender: string, payload-json: string) -> result<_, string>;
    on-session-lifecycle: func(payload-json: string) -> result<_, string>;
    on-input-submitted: func(payload-json: string) -> result<_, string>;
    /// 进程执行完成回调（v8）：host-process run 的进程结束时触发
    /// （正常退出 / 非零退出 / 超时 kill），payload-json 为
    /// `{ run_id, exit_code, timed_out }`
    on-process-done: func(payload-json: string) -> result<_, string>;
}

/// v11：二进制消息接收（可选导出，**不进 `plugin` world 的必选导出列表**）
///
/// 宿主在实例化后动态探测 `bedcode:plugin/events-binary#on-message-binary`：
/// - 旧插件（v10 及更早，未用新 SDK 编译）不导出本接口 → 探测为 None，
///   只接收 JSON 消息；二进制消息对其按「格式不匹配」拒绝，不影响加载；
/// - 新插件（v11 SDK）由 `wasm_entry!` 宏无条件导出（默认空实现），
///   订阅方以 `host-bus.subscribe-binary` 声明偏好后即可接收二进制投递
///
/// 无返回值（观察型回调，语义同 terminal-hooks）：guest 内部处理失败经
/// host-log 记录，不打断宿主投递链；host 侧仅 trap 会上抛
interface events-binary {
    on-message-binary: func(topic: string, sender: string, payload: list<u8>);
}
/// 终端输入/输出钩子（原 on_terminal_input/on_terminal_output）
interface terminal-hooks {
    on-terminal-input: func(session-id: string, text: string) -> option<string>;
    on-terminal-output: func(session-id: string, data: string) -> option<string>;
}

/// 插件 manifest（原 __bedcode_manifest，JSON 字符串）
interface manifest {
    get: func() -> string;
}

/// ABI 版本协商（原 __bedcode_abi_version + 阶段 A 新增 form 形态字段）
///
/// 版本演进（与 SDK `abi.rs` 的 ABI_VERSION 序列逐条对应，不得漂移）：
/// - v10：host-peer 原语化收缩第一阶段（dial-peer-endpoint / close /
///   set-shared-roots + host-mdns / host-platform），纯增量
/// - v11：host-peer 传输控制三原语（pause-transfer / resume-transfer /
///   resume-all-transfers），纯增量
/// - v12：消息总线二进制载荷（host-bus.publish-binary / subscribe-binary）
///   + 可选导出 events-binary（宿主动态探测，旧插件不受影响）
/// - v13：host-mdns v2（advertise / stop-advertise / is-advertising 原语 +
///   事件定向投递 `mdns:found.<owner>` / `mdns:lost.<owner>`），纯增量
/// - v14：host-websocket 基础能力服务（客户端域 connect/send/close/
///   is-connected + 服务端域 register-endpoint/收发/广播/踢出/注销/清单）
///   + 可选导出 events-ws（宿主动态探测），纯增量，v13 插件不受影响
interface abi {
    version: func() -> u32;
    form: func() -> u32;
}

// ==================== World ====================

/// 插件世界：宿主能力全部为 import，插件行为全部为 export
///
/// 阶段 A 收尾后宿主已全部接线（13 组 import），完整 world 可直接实例化；
/// 阶段 B SDK 构建脚本以本 world 生成 guest 绑定。
world plugin {
    import host-storage;
    import host-database;
    import host-plugin-database;
    import host-terminal;
    import host-session;
    import host-events;
    import host-http;
    import host-fs;
    import host-config;
    import host-log;
    import host-bus;
    import host-api-call;
    import host-peer;
    import host-mdns;
    import host-platform;
    import host-timer;
    import host-process;
    import host-app;
    import host-websocket;

    export command;
    export lifecycle;
    export events;
    export terminal-hooks;
    export manifest;
    export abi;
}

/// v11：二进制消息接收专用 world（**仅 SDK 绑定用，宿主不实例化它**）
///
/// 宿主对 `plugin` world 的导出全部按必选实例化，旧插件（v10 及更早）不导出
/// `events-binary`，因此它不能声明进 `plugin` world（否则旧插件无法加载）；
/// 宿主改为实例化后动态探测 `bedcode:plugin/events-binary#on-message-binary`。
/// 本 world 让 SDK 的 `wasm_binary` 模块生成 events-binary 的 guest 绑定
/// （Guest trait + export!），使 `wasm_entry!` 能无条件导出默认实现
/// （空实现亦可被宿主动态探测命中）。
world plugin-binary {
    export events-binary;
}

/// v14：WS 消息帧接收（可选导出，**不进 `plugin` world 必选导出列表**——同 events-binary）
///
/// 宿主实例化后动态探测 `bedcode:plugin/events-ws`；未导出则：状态事件照收（bus），
/// 消息帧丢弃并首次 `warn!` + 计数（宿主不缓存）。
/// kind = "text" | "binary"，payload 统一列表（text 为 UTF-8 字节——零 JSON 转义、
/// 非 UTF-8 直通）。分片 / 压缩 / opcode 已在宿主侧归一，**同一连接内的帧按到达序
/// 投递**（保序，D2）。
/// 无返回值（观察型回调，同 terminal-hooks / events-binary）：插件处理失败经
/// host-log 记录；宿主仅 `error!` 记录 trap（含 endpoint-id / client-id 字段）并计数，
/// 不断开连接、不中断后续帧投递。
interface events-ws {
    /// 客户端域：handle 为连接句柄 `wsc-<uuid>`
    on-message: func(handle: string, kind: string, payload: list<u8>);
    /// 服务端域：endpoint-id 为端点句柄、client-id 为对端连接 id
    on-client-message: func(endpoint-id: string, client-id: string, kind: string, payload: list<u8>);
}

/// v14：events-ws 绑定专用 world（**仅 SDK 绑定用，宿主不实例化它**）——同 plugin-binary
///
/// 宿主对 `plugin` world 的导出全部按必选实例化，未导出 `events-ws` 的插件不能
/// 因此加载失败，故该接口不声明进 `plugin` world；宿主改为实例化后动态探测。
/// 本 world 让 SDK 生成 events-ws 的 guest 绑定（Guest trait + export!），
/// 使 `wasm_entry!` 能无条件导出默认实现（空实现亦可被宿主动态探测命中）。
world plugin-ws {
    export events-ws;
}

/// 系统组件 world（**仅供系统组件构建绑定，宿主仍以 `plugin` world 实例化**）
///
/// 系统组件（manifest `type: "system"`，core-plugin-manager 票据 06）在
/// `plugin` world 标准导出之外，追加导出其提供的能力接口——能力接口与宿主
/// import 同形（复用 host-* 接口定义，不引入新的组件组合 world）。宿主按
/// `plugin` world 实例化后动态探测能力接口导出（同 events-binary 模式），
/// 命中即把该能力注册为「系统组件实例」提供者；未命中宿主 import 侧仍由
/// 宿主原语直连，应用插件无感。
///
/// `plugin` world 本身不变（既有插件零迁移，ABI 版本无需 bump）。
world plugin-system {
    export command;
    export lifecycle;
    export events;
    export terminal-hooks;
    export manifest;
    export abi;

    /// 能力导出：宿主 KV 存储同形接口（装配框架首条路由能力）
    export host-storage;
}
