package bedcode:plugin@0.2.0;
// ======================================================================
// HTTP 服务端域（桌面扩展分片，自 `host-http` 拆出）
//
// 双端功能区分的归属（ADR 0052 D3/D4）：出站 `host-http`（1 函数）是双端功能级
// 交集，契约与实现都归能力域 crate `bedcode-server-http`（真源
// `packages/bedcode-server-http/wit/http.wit`，world `cap-http`）；本 interface
// 只剩桌面独有服务端域（入站路由注册 2 函数，v29 HTTP 路由代码注册下沉专项）。
// 移动端是自持业务 App，不承载服务端网关与插件入站路由（ADR 0018），不跟演
// （ADR 0019 双端偏离）。
//
// 属主隔离：**全部函数仅属主可调**；注册表按调用方插件
// 注入 `plugin_id`（插件不能注册他人名下路由）；插件停用时宿主自动清空其全部注册
// 路由（同 host-websocket `purge_for_plugin` 先例）。
//
// 权限：`network:http`（与前端面 `http.registerEndpoint` 同权限位）。
//
// 桌面端 cap 真源：`compose.json` caps.http-endpoint 指向本文件，
// 由 `scripts/compose-wit.mjs` 复制为生成物 `rust/wit/cap-http-endpoint.wit`。
interface host-http-endpoint {
    /// 在宿主 HTTP 服务器注册插件端点。config-json（camelCase）：
    /// `{ path, host?, methods?, auth? }`
    /// - `path`：插件内相对端点段，宿主拼出内部可达路径 `/api/plugin/<plugin-id>/<path>`
    ///   （命名空间段由宿主注入，插件只提供后缀）；
    /// - `host`：可选对外 URL 别名（如 `/api/configs`；支持 `{id}` 模板段如
    ///   `/api/sessions/{id}/stop`——模板捕获值经 `_http_endpoint` 的 `params` 字段
    ///   传给插件，宿主不拿捕获值构造路径）；
    /// - `methods`：host 别名的允许方法（缺省 `["GET"]`）；
    /// - `auth` = "jwt"（缺省，最严：要求宿主已验签）| "none"（免凭证转发）。
    ///
    /// 冲突仲裁（fail-visible）：同一 `host+method` 已被其他插件注册 → `Err`（不覆盖
    /// 在位者）；本插件内部 path 重复注册 → `Err`。成功 → 返回端点句柄 `http-<uuid>`。
    register-endpoint: func(config-json: string) -> result<string, string>;
    /// 注销本插件注册的端点（未知句柄 → `Ok(false)`，他人句柄 → `Err` 属主仲裁）；
    /// 宿主侧插件停用回收同样会清空其全部注册路由（幂等）。
    unregister-endpoint: func(endpoint-id: string) -> result<bool, string>;
}
world cap-http-endpoint {
    import host-http-endpoint;
}
