{
  "name": "@bedcode/plugin-sdk-desktop",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bedcode-plugin-desktop": "./bin/cli.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "template",
    "dev-shell",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite-plugin.ts src/types.ts --format esm --dts --clean",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./ui": {
      "types": "./src/ui/Select.d.ts",
      "import": "./src/ui/Select.vue"
    },
    "./ui/terminal-input-rail": {
      "types": "./src/ui/terminal-input-rail.d.ts",
      "import": "./src/ui/TerminalInputRail.vue"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^13.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  }
}
