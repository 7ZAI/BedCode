{
  "id": "com.bedcode.ai-chatbox",
  "name": "AI Chatbox",
  "version": "2.0.0",
  "description": "AI 大模型对话（OpenAI 兼容供应商，JSONL 对话日志落盘）",
  "author": "BedCode",
  "icon": "💬",
  "main": "index.js",
  "pluginType": "wasm",
  "rustLibrary": "bedcode_plugin_ai_chatbox",
  "permissions": [
    "fs:read",
    "fs:write",
    "network:http",
    "storage",
    "ui:navtab",
    "ui:toolbox"
  ],
  "contributes": {
    "commands": [
      {
        "id": "ai-chatbox.chat-stream",
        "title": "Chat Stream"
      },
      {
        "id": "ai-chatbox.chat-complete",
        "title": "Chat Complete"
      },
      {
        "id": "ai-chatbox.fetch-models",
        "title": "Fetch Models"
      },
      {
        "id": "ai-chatbox.list-conversations",
        "title": "List Conversations"
      },
      {
        "id": "ai-chatbox.get-messages",
        "title": "Get Messages"
      },
      {
        "id": "ai-chatbox.save-conversation",
        "title": "Save Conversation"
      },
      {
        "id": "ai-chatbox.save-message",
        "title": "Save Message"
      },
      {
        "id": "ai-chatbox.delete-conversation",
        "title": "Delete Conversation"
      }
    ],
    "views": [
      {
        "type": "toolbox",
        "id": "ai-chatbox.toolbox",
        "title": "AI 对话",
        "component": "ChatView"
      }
    ],
    "navTab": {
      "id": "ai-chatbox.navtab",
      "title": "AI",
      "icon": "💬",
      "component": "ChatView",
      "order": 10
    }
  }
}
