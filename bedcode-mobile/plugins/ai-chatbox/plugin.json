{
  "id": "com.bedcode.ai-chatbox",
  "name": "AI Chatbox",
  "version": "1.0.0-beta",
  "description": "AI 大模型对话：支持 OpenAI 兼容 / Anthropic / Gemini 多供应商\n· 多供应商管理：Base URL、API Key、模型均可配置\n· 流式输出，思考模式与推理强度可调\n· 会话管理：历史会话保存、恢复、删除\n· 对话日志 JSONL 落盘，可追溯审计\n使用：在底部导航「AI」页对话；首次使用先进设置添加供应商并选择模型，随后即可开始聊天。",
  "author": "BedCode",
  "icon": "💬",
  "main": "index.js",
  "pluginType": "wasm",
  "rustLibrary": "bedcode_plugin_ai_chatbox",
  "permissions": [
    "fs:read",
    "fs:write",
    "network:http",
    "storage",
    "ui:navtab",
    "ui:toolbox"
  ],
  "contributes": {
    "commands": [
      {
        "id": "ai-chatbox.chat-stream",
        "title": "Chat Stream"
      },
      {
        "id": "ai-chatbox.chat-complete",
        "title": "Chat Complete"
      },
      {
        "id": "ai-chatbox.fetch-models",
        "title": "Fetch Models"
      },
      {
        "id": "ai-chatbox.list-conversations",
        "title": "List Conversations"
      },
      {
        "id": "ai-chatbox.get-messages",
        "title": "Get Messages"
      },
      {
        "id": "ai-chatbox.save-conversation",
        "title": "Save Conversation"
      },
      {
        "id": "ai-chatbox.save-message",
        "title": "Save Message"
      },
      {
        "id": "ai-chatbox.delete-conversation",
        "title": "Delete Conversation"
      }
    ],
    "views": [
      {
        "type": "toolbox",
        "id": "ai-chatbox.toolbox",
        "title": "AI 对话",
        "component": "ChatView"
      }
    ],
    "navTab": {
      "id": "ai-chatbox.navtab",
      "title": "AI",
      "icon": "M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
      "component": "ChatView",
      "order": 150
    },
    "configuration": {
      "title": "AI Chatbox 设置",
      "properties": {
        "thinkingMode": {
          "type": "string",
          "enum": ["default", "enabled", "disabled"],
          "title": "思考模式",
          "description": "default：跟随模型自身默认行为，不传思考参数；enabled：强制开启思考；disabled：强制关闭思考",
          "default": "default"
        },
        "reasoningEffort": {
          "type": "string",
          "enum": ["low", "high", "max"],
          "title": "推理强度",
          "description": "仅思考模式为「强制开启」时生效（low / high / max）",
          "default": "high"
        },
        "showReasoning": {
          "type": "boolean",
          "title": "显示思考过程",
          "description": "关闭后聊天界面不展示思考过程块（思考内容仍随对话日志落盘）",
          "default": true
        },
        "codeLineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "title": "代码块行距",
          "description": "代码块行距（0.5-2.0，默认 1.6）",
          "default": 1.6
        },
        "codeFontSize": {
          "type": "number",
          "minimum": 11,
          "maximum": 18,
          "title": "代码块字体大小",
          "description": "代码块字体大小（px，11-18）",
          "default": 13
        },
        "codeTheme": {
          "type": "string",
          "enum": ["auto", "light", "dark", "github-light", "github-dark", "dracula"],
          "title": "代码高亮主题",
          "description": "auto：跟随宿主深浅色；light/dark：通用浅深色；github-light/github-dark/dracula：具名风格主题",
          "default": "auto"
        }
      }
    }
  }
}
