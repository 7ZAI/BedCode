{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capabilities for mobile platforms (Android/iOS)",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:app:default",
    "core:window:default",
    "core:webview:default",
    "dialog:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "edge-to-edge:allow-enable",
    "edge-to-edge:allow-disable",
    "edge-to-edge:allow-get-safe-area-insets",
    "edge-to-edge:allow-get-keyboard-info",
    "edge-to-edge:allow-show-keyboard",
    "edge-to-edge:allow-hide-keyboard",
    "machine-uid:default"
  ]
}
