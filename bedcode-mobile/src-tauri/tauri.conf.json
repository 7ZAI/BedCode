{
  "productName": "BedCode Mobile",
  "identifier": "com.bedcode.mobile",
  "version": "2.0.10",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BedCode Mobile",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "backgroundColor": "#0F0D0A"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/**/*", "$APPCONFIG/**/*", "$APPDATA/**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/config.json",
      "resources/plugins/**/*",
      "resources/ocr_models/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
