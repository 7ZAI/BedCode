{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@binblink/plugin-sdk-mobile": ["./packages/plugin-sdk-mobile/src/index.ts"],
      "@binblink/plugin-sdk-mobile/ui": ["./packages/plugin-sdk-mobile/src/ui/Select.d.ts"],
      "@binblink/plugin-sdk-mobile/*": ["./packages/plugin-sdk-mobile/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts", "packages/plugin-sdk-mobile/src/**/*.ts"],
  "exclude": ["src/__tests__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
