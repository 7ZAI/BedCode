{
  "id": "com.bedcode.terminal-session",
  "name": "Terminal Session",
  "version": "1.0.0-beta",
  "description": "远程终端控制端：订阅桌面端会话的终端输出并发送输入，内置自动任务面板\n· 终端流：订阅回放 + 实时输出，断线自动重连并补齐环窗口\n· 输入：可打印文本与特殊键（Ctrl+C / 方向键 / 功能键）直达桌面 PTY\n· 流控：渲染背压 ack，输出风暴期自动驻留防卡顿\n· 自动任务：任务队列面板（会话工具栏入口）+ 工具箱「任务记录 / 定时任务」，数据为桌面端任务域的只读视图\n使用：两端连接后进入会话终端页即自动订阅；离开页面自动断开（不在后台常拉）。自动任务在会话工具栏「自动任务」入口打开，选目标会话后创建任务入队，开启自动执行即按队列顺序调度。",
  "author": "BedCode",
  "icon": "icon.svg",
  "main": "index.js",
  "pluginType": "wasm",
  "rustLibrary": "bedcode_plugin_terminal_session",
  "permissions": [
    "auth",
    "bus",
    "network:http",
    "session:read",
    "storage",
    "terminal:output",
    "ui:input",
    "ui:route",
    "ui:toolbox",
    "ws:client"
  ],
  "contributes": {
    "commands": [
      {
        "id": "terminal-session.subscribe",
        "title": "Subscribe Session Terminal"
      },
      {
        "id": "terminal-session.unsubscribe",
        "title": "Unsubscribe Session Terminal"
      },
      {
        "id": "terminal-session.unsubscribe-all",
        "title": "Unsubscribe All Terminals"
      },
      {
        "id": "terminal-session.remove",
        "title": "Remove Session Terminal Link"
      },
      {
        "id": "terminal-session.send-input",
        "title": "Send Terminal Input"
      },
      {
        "id": "terminal-session.ack-rendered",
        "title": "Ack Rendered Bytes"
      },
      {
        "id": "terminal-session.get-state",
        "title": "Get Terminal Link State"
      },
      {
        "id": "terminal-session.request-pairing",
        "title": "Request Pairing"
      },
      {
        "id": "terminal-session.verify-pairing-code",
        "title": "Verify Pairing Code"
      },
      {
        "id": "terminal-session.authenticate-with-qr",
        "title": "Authenticate With QR Token"
      },
      {
        "id": "terminal-session.authenticate-with-biometric",
        "title": "Authenticate With Biometric"
      },
      {
        "id": "terminal-session.list-sessions",
        "title": "List Sessions"
      },
      {
        "id": "terminal-session.start-session",
        "title": "Start Session"
      },
      {
        "id": "terminal-session.stop-session",
        "title": "Stop Session"
      },
      {
        "id": "terminal-session.remove-session",
        "title": "Remove Session"
      },
      {
        "id": "terminal-session.send-http-input",
        "title": "Send Session Input (HTTP)"
      }
    ],
    "terminal": {
      "toolbarItems": [
        {
          "id": "terminal-session.task-toolbar",
          "title": "Auto Task",
          "icon": "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 7l2 2 4-4"
        }
      ]
    },
    "views": [
      {
        "type": "toolbox",
        "id": "terminal-session.toolbox",
        "title": "自动任务",
        "icon": "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 7l2 2 4-4",
        "component": "AutoTaskToolboxView"
      }
    ],
    "routes": [
      {
        "id": "tasks",
        "component": "AutoTaskToolboxView",
        "header": true
      }
    ]
  }
}
