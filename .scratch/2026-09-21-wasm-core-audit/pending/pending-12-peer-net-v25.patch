+static MDNS_FOUND_TOPIC: std::sync::LazyLock<String> =
+    std::sync::LazyLock::new(|| mdns_event_topic(MDNS_FOUND, PLUGIN_ID));
+static MDNS_LOST_TOPIC: std::sync::LazyLock<String> =
