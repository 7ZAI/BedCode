+/// 自建 mDNS browse（幂等：已有句柄不动；失败降级返回 None，刷新时补建）
+fn ensure_mdns_browse(h: &WasmHost) -> Option<String> {
+    let mut slot = mdns_browser().lock().expect("mdns browser slot lock");
+    if slot.is_some() {
+        return slot.clone();
+    }
