  "cards": [
    {
      "dot": "cyan",
      "title": "插件接管业务状态",
      "items": [
        "设备缓存、任务队列、共享根注册表、接收策略均由插件 WASM 自持",
        "任务历史归档进插件私有 SQLite，重启标注 interrupted 并回放 retryMeta",
        "节点与 mDNS 生命周期由宿主 activate/deactivate 外壳驱动，插件不建第二守护；TXT 携带能力位图"
      ]
    },
    {
      "dot": "violet",
      "title": "宿主只剩引擎原语",
      "items": [
        "宿主只暴露进程 / 网络 / 存储 / 安全 / 通信五类无业务语义原语",
        "peer_* 调用在 WASM 边界即校验 TrustStore 闸门，未信任节点直接拒绝",
        "文件系统访问走 fs_auth 三层校验：路径白名单 → 插件白名单 → 弹窗授权"
      ]
    },
    {
      "dot": "rose",
      "title": "一次握手定信任",
      "items": [
        "拨号侧按发现记录持有的 NodeId 精确钉扎服务端证书 SPKI 指纹",
        "信任放行发生在应用层查 TrustStore：未信任节点仍可见，等 confirm-connection",
        "凭据与证书指纹只记长度不落明文，日志与存储同规"
      ]
    },
    {
      "dot": "emerald",
      "title": "传输协议与状态真源",
      "items": [
        "控制帧 JSON 与数据块帧共用一条连接：[u32 BE len][u8 kind][payload]",
        "接收端 StartFile 声明起点偏移：接收端已写字节即断点真源",
        "Pause 冻结进度 / Cancel 关闭会话保留 .part，同 batch_id 重发 Offer 即续传"
      ]
    }
  ]
