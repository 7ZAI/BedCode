  "cards": [
    {
      "dot": "cyan",
      "title": "四段进程隔离",
      "items": [
        "渲染进程只持有 xterm.js 与能力解析，不直接接触系统 pty",
        "共享进程仅做 IPtyService 代理，靠 HeartbeatService 检测并重启 pty host",
        "PtyService 独立成进程，终端崩溃不会拖垮整个编辑器"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据面与控制面分离",
      "items": [
        "输出走 onProcessData 事件流，输入走 input() 命令式 RPC",
        "resize、sendSignal、clearBuffer、getCwd 都经同一代理转发",
        "acknowledgeDataEvent 用高低水位实现跨进程反压"
      ]
    },
    {
      "dot": "amber",
      "title": "能力是逐步升级的",
      "items": [
        "TerminalCapabilityStore 先挂 PartialCommandDetection，见到 OSC 后升级为 CommandDetection",
        "脚本注入失败会记录具体原因而非静默降级",
        "AutoApprove 解析器在自动化 profile 上把关是否可跳过 shell"
      ]
    }
  ]
