    { "id": "capability-upgrade", "from": "addon", "to": "caps", "label": "OSC 633; A/B/C/D/E", "classification": "结构化工件", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [960, 499] },
    { "id": "ack", "from": "xterm", "to": "flowctrl", "label": "acknowledgeDataEvent(5000)", "classification": "已解析字符确认", "variant": "dashed", "fromSide": "left", "toSide": "right", "via": [[880, 157], [880, 613]], "labelAt": [705, 613] },
    { "id": "pause", "from": "flowctrl", "to": "termproc", "label": "pty.pause() / resume()", "classification": "反压信号", "variant": "security", "fromSide": "left", "toSide": "top", "via": [[420, 613], [420, 90], [315, 90]], "labelAt": [420, 385] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "输出路径逐段聚合",
      "items": [
        "shell 输出先经 node-pty 切块，再由 TerminalDataBufferer 用 5 ms 窗口合并",
        "合并后才跨进程抛出 onProcessData，避免高频事件淹没 IPC 通道",
        "跨进程代理不做 ProxyChannel 转发，防止多层代理丢事件"
      ]
    },
    {
      "dot": "rose",
      "title": "反压水位",
      "items": [
        "未确认字符超过 100000 时暂停 pty，客户端追回 5000 以内才恢复",
        "客户端每累计 5000 字符回一次 acknowledgeDataEvent",
        "回放路径由 TerminalRecorder 限量到 10 MB，重连时按 ReplayEntry 重放"
      ]
    },
    {
      "dot": "violet",
      "title": "能力解析在渲染端",
      "items": [
        "OSC 133 是通用 FinalTerm 协议，OSC 633 是 VS Code 自定义序列",
        "633;A/B/C/D 标记提示符、命令开始、执行、结束及退出码",
        "解析结果落到能力存储，驱动 Cwd 检测、ShellEnv 与命令标记"
      ]
    }
  ]
}
