  "cards": [
    {
      "dot": "cyan",
      "title": "前端层 (TS UI)",
      "items": [
        "AutoTaskModal：任务队列弹窗，支持增删改排与取消",
        "TaskHistory：侧边栏任务历史与状态统计",
        "通过 Tauri invoke 调用 Rust 命令，事件通道驱动 UI 更新"
      ]
    },
    {
      "dot": "emerald",
      "title": "核心层 (Rust WASM + SQLite)",
      "items": [
        "队列调度、状态管理、预设/定时任务状态机全在 Rust WASM 实现",
        "SQLite 保存 task_queue、task_history、session_settings、scheduled_jobs、preset_tasks",
        "命令与 HTTP 端点在 lib.rs 集中路由到 queue/scheduled/state/hooks 模块"
      ]
    },
    {
      "dot": "amber",
      "title": "Agent 集成 (Hooks + HTTP API)",
      "items": [
        "4 类 Agent hooks 在生命周期事件时调用 /api/plugin/com.bedcode.auto-task/ 推送状态",
        "HTTP API 代理到 Rust WASM，供 hooks 与移动端共用",
        "会话创建时按 agent 平台自动安装 .claude / .pi / .opencode / .codex hooks"
      ]
    },
    {
      "dot": "rose",
      "title": "基础设施 (宿主定时器 + 终端 PTY)",
      "items": [
        "宿主按 1s 周期回调 auto-task.scheduler-tick，注入 now_utc 驱动定时任务与延迟 clear",
        "终端 PTY 负责命令注入与输出观察，用于任务下发与完成判定",
        "外部 Agent 覆盖 claude / pi / opencode / codex 四种 CLI"
      ]
    }
  ]
}
