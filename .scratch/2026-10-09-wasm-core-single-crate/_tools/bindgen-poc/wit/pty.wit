package bedcode:plugin;

interface host-pty {
    /// 一次拉取的返回（游标语义见 `ring-fetch`）
    record ring-fetch-result {
        /// `[实际起点, next-offset)` 区间的原始字节（未解码，可能是非 UTF-8）
        data: list<u8>,
        /// 下一次拉取应传的游标
        next-offset: u64,
        /// `from-offset` 落后于环驻留起点（中间字节已被淘汰）→ 调用方按 resync 重建上下文
        truncated: bool,
    }

    /// 创建裸 PTY：成功返回句柄 `pty-<uuid>` 并登记属主；失败只回错误且
    /// **不发布任何事件**（无句柄可寻址）。
    /// config-json（camelCase，纯引擎参数，宿主不做 shell 解析）：
    /// `{ command, args?, env?, workingDir?, cols?, rows?, ringBytes? }`
    /// （参数数组 exec 天然免注入；`env` 为追加进继承环境的键值；尺寸缺省取宿主终端配置
    /// `terminal.default_cols` / `default_rows`，与业务线同源；`ringBytes` 是本条 PTY
    /// 的输出环容量，缺省取宿主默认，超宿主上限或超出每插件在册条数上限一律 `Err`
    /// ——配额类失败可见，不静默降级也不静默淘汰既有句柄）。
    /// v28（websocket 业务下沉）：`hostBroadcastSessionId` 字段已退役——PTY 引擎不再
    /// 知道 session id，插件经 `ring-fetch` 自持输出游标（会话语义在插件登记域）。
    spawn: func(config-json: string) -> result<string, string>;
    /// 写入输入字节（分块语义宿主内建；超单次上限 → Err）
    write: func(pty-id: string, data: list<u8>) -> result<_, string>;
    /// 调整终端尺寸（TUI 程序全屏刷新依赖）
    resize: func(pty-id: string, cols: u16, rows: u16) -> result<_, string>;
    /// 终止并销毁（优雅 Ctrl-C → 兜底强杀）；随后发布 `<owner>::pty:exit`（reason=killed）
    kill: func(pty-id: string) -> result<_, string>;
    /// 按游标拉取输出历史
    /// - `Ok(None)`：游标已追平产出端，无新字节
    /// - `Ok(Some)`：自游标起的字节（单次不超 `max-bytes`），`next-offset` 续拉不重复
    /// - `truncated = true`：`from-offset` 落后于环驻留起点，返回的是现存最早段
    /// - `Err`：句柄不存在 / 非属主 / 权限缺失
    ///
    /// **多消费者**：游标由调用方自持、互不干扰（`from-offset` 只描述本次拉取的窗口，
    /// 拉取不消费不改变全局偏移）；淘汰按产出量全局计，任一读取都不为他人保留历史，
    /// 落后于驻留起点即 `truncated`。（v28 起宿主不再是第二个消费者。）
    ring-fetch: func(pty-id: string, from-offset: u64, max-bytes: u32) -> result<option<ring-fetch-result>, string>;
    /// 进程是否仍在运行（丢失 `pty:exit` 事件后的自愈快照查询）
    is-running: func(pty-id: string) -> result<bool, string>;
}

world cap-pty {
    import host-pty;
}
