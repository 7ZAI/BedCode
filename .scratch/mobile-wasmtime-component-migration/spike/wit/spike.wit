// Ticket 01 spike 最小契约：2 个 import + 1 个 export
// （§3.1 移动端 WIT 的裁剪子集：host-log + host-storage 为 import，
//   command 为 export，类型形状与正式契约完全一致：string 载荷 / option / result<T,string>）
package bedcode:spike;

interface host-log {
    info: func(message: string);
    warn: func(message: string);
}

interface host-storage {
    get: func(key: string) -> result<option<string>, string>;
    set: func(key: string, value: string) -> result<_, string>;
}

interface command {
    invoke: func(name: string, args-json: string) -> string;
    /// 标量类型覆盖（§3.1 契约含 u32/u64/bool）：bool 透传 + u64→u32 降级，返回 result
    probe: func(flag: bool, count: u64) -> result<u32, string>;
}

world plugin {
    import host-log;
    import host-storage;
    export command;
}