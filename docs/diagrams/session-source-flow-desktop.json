  "cards": [
    {
      "dot": "emerald",
      "title": "真源在插件私有库",
      "items": [
        "会话登记 / 状态机 / 生命周期 / 输入输出编排 / 尺寸裁决整体迁入 com.bedcode.terminal-session 私有登记域（ADR 0022 P1-b，2026-09-24）",
        "session id 由插件自产并经 host-pty.spawn 的 env 注入 BEDCODE_SESSION_ID；宿主不再预分配",
        "sessions · session_annotations · auth_pairings · auth_connection_history 等表是落盘真源；宿主主库 pairings / connection_history / session_configs 三表已退役"
      ]
    },
    {
      "dot": "cyan",
      "title": "宿主侧唯一收口",
      "items": [
        "桌面 Tauri 命令 / 移动端 HTTP 控制器 / 移动端 WS 服务三条消费线收敛到 utils/session_gateway.rs 一个纯互调 api 层",
        "7 条 api：session-list / get / create / close / remove / resize / input；无内核执行器、无内核裁决副本",
        "host-session 12 原语中 9 条转为零消费者，整 interface 退役随 P4；host-terminal.terminal_send 同批裁定退役"
      ]
    },
    {
      "dot": "rose",
      "title": "输出面二进制直传",
      "items": [
        "性能红线修订：输出字节禁止经 JSON-RPC 命令通道搬运（~75 ms/MB），经 WIT 二进制原语 list<u8> 直传可进 WASM（~2.6 ms/MB）",
        "PtyRing 每句柄一条有界环（单生产者 PtyReader 写入，插件按游标 ring-fetch），容量是 spawn 的插件声明参数",
        "truncated + resync 语义即契约本体：游标落后于环驻留起点时如实上报，不静默补洞"
      ]
    },
    {
      "dot": "amber",
      "title": "无降级轨",
      "items": [
        "插件未激活 / 互调失败一律显性报错 SessionPluginRequired，前端命令面显性可见",
        "旧宿主降级实现已整体删除：PairingService · QrTokenManager · pairing.rs · session_{create,action}_bridge（含 Ok(None) 降级轨）· 双写期 bridge",
        "存量迁移链 wasm_core/legacy/ 四迁移同批退役——不再兼容旧版本存量用户"
      ]
    }
  ]
