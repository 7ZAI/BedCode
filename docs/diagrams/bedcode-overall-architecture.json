  "cards": [
    {
      "dot": "rose",
      "title": "微内核裁剪线 (ADR 0022)",
      "items": [
        "宿主只回答「机制怎么做」，不回答「这件事是什么、给谁用、怎么组织」；命中 B1–B6 一律下沉插件",
        "wasm-core 只承载应用无关引擎：进程 · 网络 · 存储 · 安全 · 通信总线 + wasmtime 运行时",
        "宿主允许存在的四类薄壳：① 引擎实现 ② 安全闸门 (fail-closed) ③ 通用注册表 ④ 零解析窄转发"
      ]
    },
    {
      "dot": "emerald",
      "title": "业务真源在插件",
      "items": [
        "terminal-session 私有库持有会话 / 设备 / 配对 / 连接历史 / 任务真源；auto-task 功能已并入",
        "宿主调会话一律经 session_gateway 纯互调 api 7 条；插件未激活显性报错、无降级轨",
        "auth-policy 由 terminal-session 实现；宿主桥接门只做一次问中心 + 三态裁决 (deny_kind)"
      ]
    },
    {
      "dot": "cyan",
      "title": "WASM 沙箱与 ABI",
      "items": [
        "wasmtime 48 Component Model · 目标 wasm32-wasip3 · 桌面 ABI v34 / 移动 ABI v16 (ADR 0019)",
        "会话创建经 host-pty.spawn 自产 id 并注入 BEDCODE_SESSION_ID；ptyQuota 加载期区间仲裁",
        "每插件实例同刻仅一个 guest 调用在执行；跨实例经 core-bus 属主命名空间隔离 (ADR 0029)"
      ]
    },
    {
      "dot": "amber",
      "title": "跨设备链路与认证中心",
      "items": [
        "认证中心 ADR 0031：显式注册单中心 + 组合式 grant；ADR 0033：自持签发与验签，宿主零密钥接触",
        "认证裁决 fail-closed：中心未在册 / 调用失败 / 拒绝 → 一律拒绝，无「查不到就放行」降级",
        "mDNS 单守护 + WebSocket 终端 TB v3 (拉取模型) + HTTP REST (JWT) + link-crypto 加密链路"
      ]
    },
    {
      "dot": "violet",
      "title": "wasm-core 整核与能力域 crate",
      "items": [
        "ADR 0037 整核抽出：wasm_core / db / enums / host_api / manager / security 全部搬到 packages/bedcode-wasm-core",
        "ADR 0038/0039 引擎面迁出：pty-engine 承接 host-pty WIT 接线；session_gateway 与 auth_center 桥接回宿主 lib",
        "ADR 0035 能力域 crate 化：pty-engine · discovery-engine · crypto-engine · server-* · link-crypto · peer-net · 双端共享锚点 host-kit"
      ]
    }
  ]
}
