  "cards": [
    { "dot": "rose", "title": "背压与 ack 反馈环", "items": [
      "PTY 读取按会话整体记账：unacked 超 64KB 暂停该会话 PTY 读，降到 8KB 恢复",
      "桌面端订阅通道满时 try_send 丢弃（2s 超时），慢订阅者不阻塞 on_output",
      "ack 起点是 WebView 渲染游标（onWriteParsed），经 TerminalLink 节流后回发"
    ] },
    { "dot": "cyan", "title": "两级合并与拆块", "items": [
      "桌面端 OutputBuffer 有界延迟合并：30ms 时间窗或 64KB 先到先发",
      "移动端 writeCoalescer rAF 合并同帧写入，消除 TUI 滚动残影",
      "写入按 64KB 拆块，每 128KB 让出主线程，防输出风暴冻结触摸"
    ] },
    { "dot": "emerald", "title": "字节游标与历史回放", "items": [
      "TB v3 帧头 16 字节：magic 'TB' + version 3 + flags + start_offset(8LE) + len(4LE)",
      "live 帧（end > snapshot_offset）才推 terminal-frame 事件；历史段只入 16MB LRU 缓存",
      "进终端页一次性拉取历史拼接，重连按 from_offset 增量续传，游标缺口即告警"
    ] }
  ]
